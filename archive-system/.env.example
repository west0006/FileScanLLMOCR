# 环境变量模板 — 复制为 .env 后修改
# cp .env.example .env

APP_ENV=development
# AI 模式: mock | ollama | real
# mock=模拟, ollama=本地Ollama, real=学校LLaMA-Factory
LLM_MODE=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OCR_MODE=mock
DB_MODE=sqlite
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING
